+	usize contacts_retain_frames = 0;
+	f64 contacts_retain_distance = 2;
 
 	// [Stylus]
 	bool stylus_disable = false;
@@ -107,6 +109,10 @@ public:
 
 		const f64 diagonal = std::hypot(this->width, this->height);
 
+		config.tracking.retain_frames = this->contacts_retain_frames;
+		config.tracking.retain_distance = this->contacts_retain_distance;
+		config.tracking.retain_scale = Vector2<f64> {this->width, this->height};
+
 		config.validation.track_validity = true;
 		config.validation.size_limits = Vector2<f64> {
 			this->contacts_size_min / diagonal,
diff --git a/src/core/linux/config-loader.hpp b/src/core/linux/config-loader.hpp
index 0b40293..fa92f41 100644
--- a/src/core/linux/config-loader.hpp
+++ b/src/core/linux/config-loader.hpp
@@ -177,6 +177,8 @@ private:
 		this->get(ini, "Contacts", "AspectMax", m_config.contacts_aspect_max);
 		this->get(ini, "Contacts", "PeakSuppressionRadius", m_config.contacts_peak_suppression_radius);
 		this->get(ini, "Contacts", "PeakSuppressionFactor", m_config.contacts_peak_suppression_factor);
+		this->get(ini, "Contacts", "RetainFrames", m_config.contacts_retain_frames);
+		this->get(ini, "Contacts", "RetainDistance", m_config.contacts_retain_distance);
 
 		this->get(ini, "Stylus", "Disable", m_config.stylus_disable);
 		this->get(ini, "Stylus", "TipDistance", m_config.stylus_tip_distance);
